{
  "name": "payroll-export-strategy",
  "version": "1.0.0",
  "description": "Payroll data exporter with configurable output strategies",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "ts-node -r tsconfig-paths/register src/index.ts",
    "generate-csv": "ts-node -r tsconfig-paths/register src/scripts/generateCsv.ts",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "payroll:download": "ts-node -r tsconfig-paths/register src/scripts/downloadPayrollDataset.ts",
    "payroll:run": "ts-node -r tsconfig-paths/register src/scripts/runPayrollExport.ts",
    "payroll:infra:up": "docker compose -f docker-compose.payroll.yml up -d",
    "payroll:infra:down": "docker compose -f docker-compose.payroll.yml down",
    "payroll:kafka:read": "docker exec -it payroll-kafka /opt/kafka/bin/kafka-console-consumer.sh --bootstrap-server localhost:9092 --topic citywide-payroll --from-beginning --timeout-ms 5000",
    "payroll:redis:clear": "docker exec -it payroll-redis redis-cli DEL citywide-payroll:rows",
    "payroll:redis:read": "docker exec -it payroll-redis redis-cli LRANGE citywide-payroll:rows 0 -1"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "csv-parse": "^5.5.6",
    "kafkajs": "^2.2.4",
    "redis": "^5.12.1",
    "reflect-metadata": "^0.2.2",
    "tsyringe": "^4.8.0",
    "typeorm": "^0.3.20",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/node": "^20.11.5",
    "@types/uuid": "^9.0.7",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.3.3"
  }
}
